---
import { Image } from "astro:assets";
import CaptionedFigure from "../../components/CaptionedFigure.astro";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import {
  gridBasedSelection,
  pokedraft,
  teambuilderOld,
} from "../../utils/images";

const repositoryUrl = "https://github.com/liambsulliva/kingdra-teambuilder";

const phases = [
  {
    id: "draft-prototype",
    label: "Draft prototype",
    shortDate: "May",
    date: "May 6–16, 2024",
    commits: 37,
    color: "#38bdf8",
    subject: "Draft-league rules become a one-day product",
    features: [
      "Point allowance",
      "Tera captains and types",
      "Local import and export",
      "Performance fixes",
    ],
    pivotalCommits: [
      {
        hash: "1450b37",
        subject: "implemented check for going over point allowance",
      },
      { hash: "acba8f4", subject: "implemented import/export" },
      {
        hash: "e689063",
        subject: "removing localstorage because it's more trouble than worth",
      },
    ],
  },
  {
    id: "full-stack-rebuild",
    label: "Full-stack rebuild",
    shortDate: "Jun 13–21",
    date: "June 13–21, 2024",
    commits: 65,
    color: "#22c55e",
    subject: "The specialized prototype is reset around a shared data model",
    features: [
      "Componentized interface",
      "Infinite scrolling",
      "Clerk authentication",
      "MongoDB persistence",
    ],
    pivotalCommits: [
      { hash: "705987d", subject: "reset config" },
      { hash: "8fd4bb1", subject: "working infinite scroll" },
      { hash: "eaff083", subject: "clerk authentication" },
    ],
  },
  {
    id: "competitive-core",
    label: "Competitive core",
    shortDate: "Jun 22–30",
    date: "June 22–30, 2024",
    commits: 76,
    color: "#a78bfa",
    subject: "A picker becomes a configurable competitive team builder",
    features: [
      "User-scoped CRUD",
      "IV, EV, nature, and level math",
      "Input validation",
      "Showdown interchange",
    ],
    pivotalCommits: [
      {
        hash: "a00775d",
        subject: "auth is user-specific and stores in db",
      },
      { hash: "5ebe557", subject: "pokemon stat formula" },
      { hash: "e1d221a", subject: "global import/export" },
    ],
  },
  {
    id: "product-depth",
    label: "Product depth",
    shortDate: "Jul 5–9",
    date: "July 5–9, 2024",
    commits: 79,
    color: "#f59e0b",
    subject: "Metadata, feedback, and coverage deepen every selection",
    features: [
      "Type coverage",
      "Move, item, and ability metadata",
      "Autocomplete and tooltips",
      "Toast error handling",
    ],
    pivotalCommits: [
      { hash: "6aa0e4c", subject: "branding" },
      { hash: "5dde87d", subject: "type coverages working" },
      {
        hash: "8955c19",
        subject: "autocomplete + tooltips for abilities",
      },
    ],
  },
  {
    id: "general-platform",
    label: "General platform",
    shortDate: "Jul 10–21",
    date: "July 10–21, 2024",
    commits: 107,
    color: "#fb7185",
    subject: "Casual and competitive modes converge in one platform",
    features: [
      "Multiple named teams",
      "Casual and competitive modes",
      "Smogon and encounter data",
      "GraphQL enrichment",
    ],
    pivotalCommits: [
      { hash: "4e7ee07", subject: "basic multi team support" },
      { hash: "6aaf38b", subject: "smogon endpoint" },
      {
        hash: "61832c0",
        subject: "graphql fetch works for PokemonInfo",
      },
    ],
  },
  {
    id: "visual-identity",
    label: "Visual identity",
    shortDate: "Sep",
    date: "September 5–18, 2024",
    commits: 3,
    color: "#2dd4bf",
    subject: "A short typography pass settles the product voice",
    features: [
      "Poppins trial",
      "Font deployment repair",
      "Figtree adoption",
      "Interface consistency",
    ],
    pivotalCommits: [
      { hash: "bbc9b3e", subject: "set font default to poppins" },
      { hash: "582217f", subject: "fix font deployment issues" },
      { hash: "6f880e4", subject: "figtree looks a little better" },
    ],
  },
  {
    id: "mobile-pwa",
    label: "Mobile and PWA",
    shortDate: "Oct",
    date: "October 21–22, 2024",
    commits: 29,
    color: "#60a5fa",
    subject: "The desktop-first builder becomes installable and portable",
    features: [
      "Hamburger navigation",
      "Add Pokémon modal",
      "Compact team editor",
      "Manifest and service worker",
    ],
    pivotalCommits: [
      { hash: "0204344", subject: "hamburger menu... for now" },
      { hash: "43d1f72", subject: "mobile transition complete" },
      { hash: "73aa53c", subject: "add service worker (for real)" },
    ],
  },
  {
    id: "reliability",
    label: "Reliability closeout",
    shortDate: "Dec",
    date: "December 31, 2024",
    commits: 1,
    color: "#f97316",
    subject: "The final commit protects persistence ordering",
    features: [
      "GET-before-POST ordering",
      "Database mutex",
      "Stale-write prevention",
      "Production stabilization",
    ],
    pivotalCommits: [
      {
        hash: "189101c",
        subject: "create mutex to ensure GET from DB before POST",
      },
    ],
  },
];

const totalCommits = phases.reduce((total, phase) => total + phase.commits, 0);
const maxCommitCount = Math.max(...phases.map((phase) => phase.commits));

const sidebarItems = [
  { text: "Overview", href: "#overview" },
  { text: "Origin", href: "#origin" },
  { text: "Lifecycle", href: "#lifecycle" },
  { text: "Architecture", href: "#architecture" },
  { text: "Product Evolution", href: "#product-evolution" },
  { text: "Outcome", href: "#outcome" },
];

const placeholderLead =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere, nibh vitae commodo aliquet, justo erat feugiat arcu, vitae fermentum sapien sem sed erat.";
const placeholderBody =
  "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium. Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit.";
const placeholderShort =
  "Ut enim ad minima veniam, quis nostrum exercitationem ullam corporis suscipit laboriosam.";
---

<CaseStudyLayout
  title="Kingdra Pokémon Teambuilder"
  subtitle="From Draft-League Prototype to Full-Stack PWA — May–December 2024"
  pageTitle="Kingdra Pokémon Teambuilder Lifecycle - Liam Sullivan"
  sidebarItems={sidebarItems}
  projectRole={["Full-Stack Development", "UI + UX Design"]}
  team={["Solo"]}
  tools={["Next.js", "TypeScript", "Tailwind", "React", "MongoDB"]}
  timeline={["May–December 2024"]}
  githubLink={repositoryUrl}
  demoLink="https://pokedraft.liambsullivan.com"
  isCaseStudy={false}
>
  <Image
    src={pokedraft}
    alt="Kingdra Teambuilder interface showing a configured Pokémon team"
    class="mx-auto max-h-[700px] w-auto"
    loading="eager"
    slot="hero"
  />

  <div class="case-study-layout kingdra-lifecycle">
    <section class="overview-section" id="overview">
      <div class="section-heading">
        <span class="eyebrow">Repository lifecycle</span>
        <h3>Overview</h3>
      </div>
      <div class="section-content">
        <p class="placeholder-copy">{placeholderLead}</p>
        <p class="placeholder-copy">{placeholderBody}</p>

        <ul class="metric-grid" aria-label="Repository lifecycle metrics">
          <li>
            <strong>{totalCommits}</strong>
            <span>product commits</span>
          </li>
          <li>
            <strong>36</strong>
            <span>active coding days</span>
          </li>
          <li>
            <strong>186</strong>
            <span>commits in the busiest month</span>
          </li>
          <li>
            <strong>239</strong>
            <span>calendar days from first to last commit</span>
          </li>
        </ul>
      </div>
    </section>

    <section id="origin">
      <div class="section-heading">
        <span class="eyebrow">May 2024</span>
        <h3>Draft Night Was the Constraint</h3>
      </div>
      <div class="origin-grid">
        <article class="origin-card">
          <span class="origin-index" aria-hidden="true">01</span>
          <h4>Point-Budget Drafting</h4>
          <p class="placeholder-copy">{placeholderShort}</p>
        </article>
        <article class="origin-card">
          <span class="origin-index" aria-hidden="true">02</span>
          <h4>Tera Captain Rules</h4>
          <p class="placeholder-copy">{placeholderShort}</p>
        </article>
        <article class="origin-card">
          <span class="origin-index" aria-hidden="true">03</span>
          <h4>Local Team Exchange</h4>
          <p class="placeholder-copy">{placeholderShort}</p>
        </article>
      </div>
      <p class="placeholder-copy origin-copy">{placeholderBody}</p>
    </section>

    <section id="lifecycle">
      <div class="section-heading">
        <span class="eyebrow">All 397 commits on main</span>
        <h3>Eight Phases, One Product Arc</h3>
      </div>
      <p class="placeholder-copy section-intro">{placeholderLead}</p>

      <div class="commit-pulse" aria-labelledby="commit-pulse-title">
        <div class="graphic-header">
          <div>
            <span class="graphic-kicker">Commit pulse</span>
            <h4 id="commit-pulse-title">Change volume by lifecycle phase</h4>
          </div>
          <span class="graphic-total">{totalCommits} total</span>
        </div>

        <div class="commit-bars">
          {
            phases.map((phase) => (
              <a
                class="commit-bar"
                href={`#phase-panel-${phase.id}`}
                data-phase-target={phase.id}
                aria-label={`${phase.label}: ${phase.commits} ${phase.commits === 1 ? "commit" : "commits"}`}
                style={`--bar-size: ${(phase.commits / maxCommitCount) * 100}%; --phase-accent: ${phase.color};`}
              >
                <span class="commit-bar-count">{phase.commits}</span>
                <span class="commit-bar-track" aria-hidden="true">
                  <span class="commit-bar-fill" />
                </span>
                <span class="commit-bar-label">{phase.shortDate}</span>
              </a>
            ))
          }
        </div>
        <div class="graphic-note">
          Each bar represents every commit assigned to that phase; July 10–21
          sets the scale at 107 commits.
        </div>
      </div>

      <div class="phase-explorer" data-phase-explorer>
        <div
          class="phase-tabs"
          role="tablist"
          aria-label="Kingdra lifecycle phases"
        >
          {
            phases.map((phase, index) => (
              <button
                id={`phase-tab-${phase.id}`}
                class="phase-tab"
                type="button"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`phase-panel-${phase.id}`}
                data-phase-tab={phase.id}
                tabindex={index === 0 ? 0 : -1}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                {phase.label}
              </button>
            ))
          }
        </div>

        <div class="phase-panels">
          {
            phases.map((phase, index) => (
              <article
                class="phase-panel"
                id={`phase-panel-${phase.id}`}
                role="tabpanel"
                aria-labelledby={`phase-tab-${phase.id}`}
                data-phase-panel={phase.id}
                tabindex="0"
                style={`--phase-accent: ${phase.color};`}
              >
                <div class="phase-panel-header">
                  <div>
                    <span class="phase-date">{phase.date}</span>
                    <h4>{phase.label}</h4>
                    <div class="phase-subject">{phase.subject}</div>
                  </div>
                  <div class="phase-count">
                    <strong>{phase.commits}</strong>
                    <span>{phase.commits === 1 ? "commit" : "commits"}</span>
                  </div>
                </div>

                <p class="placeholder-copy">
                  {index % 2 ? placeholderBody : placeholderLead}
                </p>

                <div class="phase-evidence">
                  <div>
                    <h5>Product subjects</h5>
                    <ul class="subject-list">
                      {phase.features.map((feature) => (
                        <li>{feature}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h5>Pivotal commit subjects</h5>
                    <ul class="commit-list">
                      {phase.pivotalCommits.map((commit) => (
                        <li>
                          <a
                            href={`${repositoryUrl}/commit/${commit.hash}`}
                            target="_blank"
                            rel="noreferrer"
                          >
                            <code>{commit.hash}</code>
                            <span>{commit.subject}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                {phase.id === "mobile-pwa" && (
                  <a class="detail-link" href="/ux/kingdra-case-study">
                    Read the detailed mobile UX case study
                    <span aria-hidden="true">→</span>
                  </a>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="architecture">
      <div class="section-heading">
        <span class="eyebrow">System map</span>
        <h3>From External Data to Saved Team</h3>
      </div>
      <p class="placeholder-copy section-intro">{placeholderBody}</p>

      <div
        class="architecture-map"
        role="img"
        aria-label="Architecture flow from PokeAPI, Smogon, and GraphQL through Next.js API routes and React state to Clerk, MongoDB, and local PWA behavior"
      >
        <svg
          class="architecture-lines"
          viewBox="0 0 1000 320"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <defs>
            <marker
              id="architecture-arrow"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="6"
              markerHeight="6"
              orient="auto-start-reverse"
            >
              <path d="M 0 0 L 10 5 L 0 10 z"></path>
            </marker>
          </defs>
          <path d="M 220 60 C 330 60, 330 160, 445 160"></path>
          <path d="M 220 160 L 445 160"></path>
          <path d="M 220 260 C 330 260, 330 160, 445 160"></path>
          <path d="M 555 160 L 675 160"></path>
          <path d="M 785 160 C 850 160, 850 60, 900 60"></path>
          <path d="M 785 160 L 900 160"></path>
          <path d="M 785 160 C 850 160, 850 260, 900 260"></path>
        </svg>

        <div class="architecture-column architecture-sources">
          <span class="architecture-label">Data sources</span>
          <div class="architecture-node">PokeAPI</div>
          <div class="architecture-node">Smogon Data</div>
          <div class="architecture-node">GraphQL</div>
        </div>
        <div class="architecture-column architecture-core">
          <span class="architecture-label">Application core</span>
          <div class="architecture-node architecture-node-primary">
            Next.js API Routes
          </div>
          <div class="architecture-node architecture-node-primary">
            React State
          </div>
        </div>
        <div class="architecture-column architecture-services">
          <span class="architecture-label">Identity and storage</span>
          <div class="architecture-node">Clerk Identity</div>
          <div class="architecture-node">MongoDB Teams</div>
          <div class="architecture-node">Local / PWA</div>
        </div>
      </div>

      <ul
        class="architecture-legend"
        aria-label="Architecture responsibilities"
      >
        <li><span aria-hidden="true">01</span>Fetch and normalize</li>
        <li><span aria-hidden="true">02</span>Calculate and validate</li>
        <li><span aria-hidden="true">03</span>Identify and persist</li>
      </ul>
    </section>

    <section id="product-evolution">
      <div class="section-heading">
        <span class="eyebrow">Interface evolution</span>
        <h3>From Draft Board to Team Workspace</h3>
      </div>
      <p class="placeholder-copy section-intro">{placeholderLead}</p>

      <div class="comparison" data-comparison>
        <div
          class="comparison-controls"
          role="group"
          aria-label="Choose an interface version"
        >
          <button
            type="button"
            data-comparison-button="prototype"
            aria-pressed="true"
          >
            Draft prototype
          </button>
          <button
            type="button"
            data-comparison-button="workspace"
            aria-pressed="false"
          >
            Team workspace
          </button>
        </div>

        <div class="comparison-stage">
          <div class="comparison-view" data-comparison-view="prototype">
            <CaptionedFigure
              caption="May 2024 — Point-budget draft interface"
              spaced={false}
            >
              <Image
                src={teambuilderOld}
                alt="Early Kingdra draft-focused layout"
                class="comparison-image"
                loading="lazy"
              />
            </CaptionedFigure>
          </div>
          <div class="comparison-view" data-comparison-view="workspace">
            <CaptionedFigure
              caption="July 2024 — Grid-based general team selection"
              spaced={false}
            >
              <Image
                src={gridBasedSelection}
                alt="Later Kingdra grid-based team selection layout"
                class="comparison-image"
                loading="lazy"
              />
            </CaptionedFigure>
          </div>
        </div>
      </div>

      <div class="mobile-bridge">
        <div>
          <span class="graphic-kicker">October 2024</span>
          <h4>Mobile and PWA Release</h4>
        </div>
        <p class="placeholder-copy">{placeholderShort}</p>
        <a class="detail-link" href="/ux/kingdra-case-study">
          Explore the mobile design narrative
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section id="outcome">
      <div class="section-heading">
        <span class="eyebrow">December 2024</span>
        <h3>The Product at Closeout</h3>
      </div>
      <p class="placeholder-copy section-intro">{placeholderBody}</p>

      <ul class="outcome-grid" aria-label="Completed Kingdra capabilities">
        <li>
          <span class="outcome-number">01</span>
          <h4>Build</h4>
          <span class="outcome-detail">
            Multiple named teams with complete competitive sets
          </span>
        </li>
        <li>
          <span class="outcome-number">02</span>
          <h4>Calculate</h4>
          <span class="outcome-detail">
            Stats, natures, levels, type coverage, and speed modifiers
          </span>
        </li>
        <li>
          <span class="outcome-number">03</span>
          <h4>Discover</h4>
          <span class="outcome-detail">
            Search, encounter data, forms, cries, and Smogon tiers
          </span>
        </li>
        <li>
          <span class="outcome-number">04</span>
          <h4>Move</h4>
          <span class="outcome-detail">
            Showdown import/export, cloud persistence, and PWA access
          </span>
        </li>
      </ul>

      <div class="closing-commit">
        <div>
          <span class="graphic-kicker">Final commit</span>
          <h4>Persistence Ordering</h4>
        </div>
        <a
          href={`${repositoryUrl}/commit/189101c`}
          target="_blank"
          rel="noreferrer"
        >
          <code>189101c</code>
          <span>create mutex to ensure GET from DB before POST</span>
        </a>
      </div>
    </section>
  </div>
</CaseStudyLayout>

<script>
  const explorer = document.querySelector<HTMLElement>("[data-phase-explorer]");

  if (explorer) {
    const tabs = Array.from(
      explorer.querySelectorAll<HTMLButtonElement>("[data-phase-tab]"),
    );
    const panels = Array.from(
      explorer.querySelectorAll<HTMLElement>("[data-phase-panel]"),
    );
    const pulseLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-phase-target]"),
    );

    const selectPhase = (phaseId: string, focusPanel = false) => {
      tabs.forEach((tab) => {
        const selected = tab.dataset.phaseTab === phaseId;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });

      panels.forEach((panel) => {
        const selected = panel.dataset.phasePanel === phaseId;
        panel.hidden = !selected;
        if (selected && focusPanel) panel.focus();
      });

      pulseLinks.forEach((link) => {
        if (link.dataset.phaseTarget === phaseId) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    explorer.dataset.enhanced = "true";
    selectPhase(tabs[0]?.dataset.phaseTab ?? "");

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        selectPhase(tab.dataset.phaseTab ?? "");
      });

      tab.addEventListener("keydown", (event) => {
        let nextIndex = index;

        if (event.key === "ArrowRight" || event.key === "ArrowDown") {
          nextIndex = (index + 1) % tabs.length;
        } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = tabs.length - 1;
        } else {
          return;
        }

        event.preventDefault();
        const nextTab = tabs[nextIndex];
        if (!nextTab) return;
        selectPhase(nextTab.dataset.phaseTab ?? "");
        nextTab.focus();
      });
    });

    pulseLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        selectPhase(link.dataset.phaseTarget ?? "", true);
      });
    });
  }

  const comparison = document.querySelector<HTMLElement>("[data-comparison]");

  if (comparison) {
    const buttons = Array.from(
      comparison.querySelectorAll<HTMLButtonElement>(
        "[data-comparison-button]",
      ),
    );
    const views = Array.from(
      comparison.querySelectorAll<HTMLElement>("[data-comparison-view]"),
    );

    const selectComparison = (viewId: string) => {
      buttons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.comparisonButton === viewId),
        );
      });
      views.forEach((view) => {
        view.hidden = view.dataset.comparisonView !== viewId;
      });
    };

    comparison.dataset.enhanced = "true";
    selectComparison("prototype");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        selectComparison(button.dataset.comparisonButton ?? "");
      });
    });
  }
</script>

<style>
  .kingdra-lifecycle {
    --panel-border: rgba(255, 255, 255, 0.12);
    --panel-background: rgba(255, 255, 255, 0.035);
    --muted-text: #a1a1aa;
  }

  .kingdra-lifecycle section {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .kingdra-lifecycle section:last-child {
    border-bottom: 0;
  }

  .overview-section {
    display: grid;
    grid-template-columns: minmax(10rem, 0.55fr) minmax(0, 1.45fr);
    gap: 4rem;
    padding-top: 2.5rem !important;
  }

  .section-heading {
    margin-bottom: 1.5rem;
  }

  .section-heading h3 {
    margin: 0 !important;
    color: white;
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .eyebrow,
  .graphic-kicker,
  .phase-date,
  .architecture-label {
    display: block;
    margin: 0 0 0.55rem !important;
    color: var(--header-color) !important;
    font-size: 0.72rem !important;
    font-style: normal !important;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.2 !important;
    text-transform: uppercase;
  }

  .section-content {
    min-width: 0;
  }

  .placeholder-copy {
    margin: 0 0 1rem !important;
    color: var(--text-color) !important;
    font-style: italic;
    opacity: 0.82;
  }

  .placeholder-copy:last-child {
    margin-bottom: 0 !important;
  }

  .section-intro {
    max-width: 48rem;
    margin-bottom: 1.75rem !important;
  }

  .metric-grid,
