---
import { Image } from "astro:assets";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import CaptionedFigure from "../../components/CaptionedFigure.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import SwitchMenuPreview from "../../components/projects/SwitchMenuPreview.svelte";
import {
  switchReactMenuMockup,
  switchReactMenuScreen,
} from "../../utils/images";

const sidebarItems = [
  { text: "Overview", href: "#overview" },
  { text: "Constraints", href: "#constraints" },
  { text: "Lifecycle", href: "#lifecycle" },
  { text: "Architecture", href: "#architecture" },
  { text: "Interaction ideas", href: "#interaction-ideas" },
];

const phases = [
  {
    date: "Dec 28–31, 2024",
    label: "MVP",
    title: "A launcher over the holiday break",
    commitCount: "26 commits",
    consequence: "Responsive controller-first browsing",
    subjects: [
      "skeleton nxjs base",
      "app launching functionality",
      "shoulder buttons pagination",
      "selections via dpad",
      "automate font bundling",
    ],
  },
  {
    date: "May 6–7, 2026",
    label: "Iteration platform + first release",
    title: "Move iteration off the console",
    commitCount: "21 commits",
    consequence: "Testability without Switch hardware",
    subjects: [
      "implement vite pipeline with browser preview",
      "implement pagination dots",
      "implement last played tracking",
      "implement compact view",
      "implement custom sort mode",
      "first release",
    ],
  },
  {
    date: "May 9–14, 2026",
    label: "Feature expansion",
    title: "Turn a launcher into a navigable home surface",
    commitCount: "40 commits",
    consequence: "Discoverability and reliable offline metadata",
    subjects: [
      "implement showing page #s feature",
      "add album page",
      "implement web applet",
      "implement cached loads with manual invalidation",
      "implement game tagging with badge display",
      "add search bar functionality",
      "implement tag autocomplete in search",
    ],
  },
  {
    date: "June 8–9, 2026",
    label: "Maintenance",
    title: "Stabilize the release on console hardware",
    commitCount: "4 commits",
    consequence: "15.2 MB catalog removed; measured romfs ≈91% smaller",
    subjects: [
      "Expand README.md",
      "replace mockup img referenced in README",
      "prune legacy igdb database (commit reports 64% smaller bundle)",
      "fix virtual-keyboard lifecycle crash after RAWG loading",
    ],
  },
] as const;

const architecture = [
  {
    step: "01",
    title: "Switch.Application",
    detail: "Installed titles, IDs, icons, launch methods",
  },
  {
    step: "02",
    title: "React state + hooks",
    detail: "Selection, settings, search, cache, navigation",
  },
  {
    step: "03",
    title: "react-tela + WebGL2",
    detail: "Canvas-shaped scene API over the current GPU renderer",
  },
  {
    step: "04",
    title: "Switch input",
    detail: "Gamepad, touch, virtual keyboard, system applets",
  },
] as const;

const completedFeatures = [
  {
    title: "Grid + compact list",
    subject: "Controller, touch, and shoulder-button navigation",
  },
  {
    title: "Search + tags",
    subject: "Full-text filtering, tag chips, and autocomplete",
  },
  {
    title: "Metadata cache + editing",
    subject: "Offline resume, refresh, and per-title overrides",
  },
  {
    title: "Settings + sorting",
    subject: "Recent, alphabetical, release, launch count, and custom order",
  },
  {
    title: "Photo album",
    subject: "Grid browsing, lightbox navigation, and delete confirmation",
  },
  {
    title: "Web shortcut",
    subject: "System browser handoff through Switch.WebApplet",
  },
  {
    title: "Browser preview",
    subject: "Vite, nx.js polyfills, keyboard gamepad, and mouse touch",
  },
] as const;

const interactionIdeas = [
  {
    number: "01",
    title: "Keyboard as gamepad",
    keys: ["←", "→", "Q", "E", "Enter"],
    subject: "Rehearse console navigation in the browser preview.",
  },
  {
    number: "02",
    title: "Search as a spatial mode",
    keys: ["↑", "↓", "#tag", "X"],
    subject: "Keep focus, keyboard occupancy, and results in one canvas scene.",
  },
  {
    number: "03",
    title: "Progressive game detail",
    keys: ["↓", "A", "Edit"],
    subject: "Reveal metadata without replacing the launch-first home surface.",
  },
] as const;
---

<CaseStudyLayout
  title="Switch React Menu"
  subtitle="MVP in late December 2024 · Major release sprint in May 2026 · Stabilized in June 2026"
  pageTitle="Switch React Menu Lifecycle - Liam Sullivan"
  sidebarItems={sidebarItems}
  projectRole={["Console Application Development", "UI + UX Design"]}
  team={["Solo"]}
  tools={["React", "TypeScript", "nx.js", "react-tela", "Vite", "esbuild"]}
  timeline={["MVP: Dec 2024", "Release + stabilization: May–Jun 2026"]}
  githubLink="https://github.com/liambsulliva/switch-react-menu"
>
  <SwitchMenuPreview client:load slot="hero" />

  <div class="case-study-layout">
    <section class="overview-section" id="overview">
      <div class="section-heading">
        <p class="eyebrow">Overview</p>
        <h3>From break-sized experiment to complete home menu</h3>
      </div>

      <div class="overview-copy">
        <p>
          <strong>Personal context and scope.</strong> Lorem ipsum dolor sit amet,
          consectetur adipiscing elit. Integer vitae justo sed sem luctus fermentum.
          Donec posuere, sapien non feugiat tincidunt, arcu lorem porttitor nibh,
          vitae facilisis nibh lectus sed erat.
        </p>
        <p>
          <strong>Why React and TypeScript.</strong> Lorem ipsum dolor sit amet, consectetur
          adipiscing elit. Suspendisse potenti. Aenean euismod, lectus sed tincidunt
          posuere, justo erat tincidunt mi, sed tristique sem lorem vitae nibh.
        </p>
        <p>
          <strong>Why nx.js and react-tela.</strong> Lorem ipsum dolor sit amet, consectetur
          adipiscing elit. Praesent commodo, neque vitae vulputate posuere, lacus
          sapien faucibus justo, vitae aliquet erat nibh sed mauris.
        </p>
      </div>

      <div class="overview-stats" aria-label="Project lifecycle summary">
        <article>
          <strong>92</strong>
          <span>commits through June stabilization</span>
        </article>
        <article>
          <strong>4</strong>
          <span>evidence-led lifecycle phases</span>
        </article>
        <article>
          <strong>1</strong>
          <span>React tree across Switch and browser</span>
        </article>
      </div>
    </section>

    <section id="constraints">
      <div class="section-heading">
        <p class="eyebrow">Core constraint</p>
        <h3>A React interface, but no browser DOM</h3>
        <p>
          <strong>Rendering model.</strong> Lorem ipsum dolor sit amet, consectetur
          adipiscing elit. Curabitur interdum magna sed sem consequat, quis tincidunt
          tortor porta. Nunc vitae lacus at arcu feugiat volutpat vel vitae erat.
        </p>
      </div>

      <div
        class="constraint-graphic"
        role="img"
        aria-label="React tree rendered into a Nintendo Switch canvas rather than a browser DOM"
      >
        <div class="constraint-node">
          <span>Declarative source</span>
          <strong>React component tree</strong>
        </div>
        <svg viewBox="0 0 120 32" aria-hidden="true">
          <path d="M2 16h108M98 5l12 11-12 11"></path>
        </svg>
        <div class="constraint-node accent-node">
          <span>Console output</span>
          <strong>react-tela → canvas-compatible surface</strong>
        </div>
        <div
          class="dom-detour"
          aria-label="Browser DOM is not part of the console rendering path"
        >
          <span>Browser DOM</span>
          <strong>Not in the Switch render path</strong>
        </div>
      </div>

      <div class="code-example-grid">
        <article>
          <div class="example-heading">
            <span>Data model</span>
            <h4>Load the installed catalog</h4>
          </div>
          <CodeBlock
            code={`const installedApps = Array.from(Switch.Application).filter(
  (app) => app.icon,
);

setRawApps(installedApps);`}
            language="typescript"
          />
        </article>
        <article>
          <div class="example-heading">
            <span>Input model</span>
            <h4>Translate gamepad state into actions</h4>
          </div>
          <CodeBlock
            code={`const gamepad = navigator.getGamepads()[0];

if (gamepad.buttons[Button.A].pressed) {
  registerAppLaunch(app);
  app.launch();
}`}
            language="typescript"
          />
        </article>
      </div>
    </section>

    <section id="lifecycle">
      <div class="section-heading">
        <p class="eyebrow">Product lifecycle</p>
        <h3>Four phases across the first 92 commits</h3>
        <p>
          <strong>Reading the record.</strong> Lorem ipsum dolor sit amet, consectetur
          adipiscing elit. Morbi volutpat, nibh et tincidunt tristique, sem mi sollicitudin
          velit, sed consequat risus eros vitae augue.
        </p>
      </div>

      <aside class="lifecycle-bridge">
        <span>Commit 27 · Apr 29, 2026</span>
        <strong>
          1 bridge commit + 26 + 21 + 40 + 4 phase commits = 92 through June 9
        </strong>
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer
          posuere sem vitae mauris dictum, vel aliquet lacus consequat.
        </p>
      </aside>

      <ol class="timeline">
        {
          phases.map((phase, index) => (
            <li class="timeline-phase">
              <div class="timeline-marker" aria-hidden="true">
                <span>{String(index + 1).padStart(2, "0")}</span>
              </div>
              <article>
                <div class="phase-meta">
                  <span>{phase.date}</span>
                  <span>{phase.commitCount}</span>
                </div>
                <p class="phase-label">{phase.label}</p>
                <h4>{phase.title}</h4>
                <p>
                  <strong>Implementation story.</strong> Lorem ipsum dolor sit
                  amet, consectetur adipiscing elit. Sed feugiat, massa quis
                  posuere faucibus, libero justo varius nibh, id fermentum magna
                  sapien sed arcu.
                </p>
                <div
                  class="commit-subjects"
                  aria-label={`${phase.label} commit subjects`}
                >
                  {phase.subjects.map((subject) => (
                    <code>{subject}</code>
                  ))}
                </div>
                <div class="interface-consequence">
                  <span>Interface consequence</span>
                  <strong>{phase.consequence}</strong>
                  <p>
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                    Vivamus placerat magna vitae arcu dictum, non tempor tellus
                    interdum.
                  </p>
                </div>
              </article>
            </li>
          ))
        }
      </ol>

      <CaptionedFigure
        caption="The May feature sprint added search, shortcuts, a clock, metadata, and an expandable hero-detail presentation."
        class="product-figure"
      >
        <Image
          src={switchReactMenuScreen}
          alt="Switch React Menu grid with search, browser, album, settings, clock, and rich-details affordance"
          class="w-full rounded-xl"
          loading="lazy"
        />
      </CaptionedFigure>
    </section>

    <section id="architecture">
      <div class="section-heading">
        <p class="eyebrow">Architecture</p>
        <h3>One interface pipeline, two execution environments</h3>
        <p>
          <strong>System shape.</strong> Lorem ipsum dolor sit amet, consectetur adipiscing
          elit. Maecenas feugiat, nunc ut feugiat pellentesque, leo magna efficitur
          enim, at malesuada nibh neque vitae lacus.
        </p>
      </div>

      <figure class="architecture-figure">
        <div class="architecture-flow">
          {
            architecture.map((node, index) => (
              <>
                <article>
                  <span>{node.step}</span>
                  <h4>{node.title}</h4>
                  <p>{node.detail}</p>
                </article>
                {index < architecture.length - 1 && (
                  <span class="flow-arrow" aria-hidden="true">
                    →
                  </span>
                )}
              </>
            ))
          }
        </div>
        <div class="browser-layer">
          <span>Optional development layer</span>
          <strong>Vite browser preview + nx.js polyfills</strong>
          <p>
            Keyboard → gamepad · Mouse → touch · DOM input → virtual keyboard ·
            Mock catalog → Switch.Application
          </p>
        </div>
        <figcaption>
          Production uses Switch APIs directly; the preview installs compatible
          browser globals before importing the same App tree.
        </figcaption>
      </figure>

      <div class="architecture-copy">
        <p>
          <strong>State and rendering.</strong> Lorem ipsum dolor sit amet, consectetur
          adipiscing elit. Pellentesque habitant morbi tristique senectus et netus
          et malesuada fames ac turpis egestas.
        </p>
        <p>
          <strong>Offline metadata and performance.</strong> Lorem ipsum dolor sit
          amet, consectetur adipiscing elit. Duis non risus vel augue volutpat feugiat.
          Integer sit amet velit in justo tempor luctus.
        </p>
      </div>

      <div class="browser-code-example">
        <div class="example-heading">
          <span>Current console renderer</span>
          <h4>Mount react-tela to a canvas-compatible WebGL2 surface</h4>
        </div>
        <CodeBlock
          code={`const surface = createWebGLTelaSurface(screen);
const root = render(<App />, surface.canvas, {
  Path2D: TelaPath2D,
});

surface.attach(root);`}
          language="typescript"
        />
      </div>
    </section>

    <section id="interaction-ideas">
      <div class="section-heading">
        <p class="eyebrow">Interaction ideas</p>
        <h3>What the completed product supports</h3>
        <p>
          <strong>Shipped, not future work.</strong> Lorem ipsum dolor sit amet, consectetur
          adipiscing elit. Aliquam erat volutpat. Vestibulum ante ipsum primis in
          faucibus orci luctus et ultrices posuere cubilia curae.
        </p>
      </div>

      <div class="feature-inventory">
        {
          completedFeatures.map((feature) => (
            <article>
              <span aria-hidden="true">✓</span>
              <div>
                <h4>{feature.title}</h4>
                <p>{feature.subject}</p>
              </div>
            </article>
          ))
        }
      </div>

      <CaptionedFigure
        caption="The completed rich-details view keeps launching and metadata editing inside the controller-first navigation model."
        class="product-figure"
      >
        <Image
          src={switchReactMenuMockup}
          alt="Nintendo Switch mockup showing the completed rich-details interface"
          class="mx-auto w-full max-w-[1024px]"
          loading="lazy"
        />
      </CaptionedFigure>

      <div class="interaction-grid">
        {
          interactionIdeas.map((idea) => (
            <article>
              <span class="idea-number">{idea.number}</span>
              <h4>{idea.title}</h4>
              <div class="key-sequence" aria-label={`${idea.title} controls`}>
                {idea.keys.map((key) => (
                  <kbd>{key}</kbd>
                ))}
              </div>
              <p>
                <strong>{idea.subject}</strong> Lorem ipsum dolor sit amet,
                consectetur adipiscing elit. Nunc ullamcorper augue a justo
                commodo, vitae posuere nibh fermentum.
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</CaseStudyLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  section {
    scroll-margin-top: 2rem;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .section-heading h3 {
    max-width: 680px;
    color: white;
    font-size: clamp(1.75rem, 4vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .section-heading p:last-child {
    margin-top: 1rem;
  }

  .eyebrow,
  .phase-label {
    color: #76c7ff !important;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .overview-section {
    padding-top: 4rem !important;
  }

  .overview-copy,
  .architecture-copy {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .overview-copy p,
  .architecture-copy p {
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 12%);
  }

  .overview-copy strong,
  .architecture-copy strong {
    display: block;
    margin-bottom: 0.4rem;
    color: white;
  }

  .overview-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 2.5rem;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 0.9rem;
    background: rgb(255 255 255 / 12%);
  }

  .overview-stats article {
    display: flex;
    min-height: 130px;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    background: #111;
  }

  .overview-stats strong {
    color: white;
    font-size: 2.4rem;
    line-height: 1;
  }

  .overview-stats span {
    color: #a1a1aa;
    font-size: 0.82rem;
  }

  .constraint-graphic {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding: 2rem;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 1rem;
    background:
      radial-gradient(circle at 80% 20%, rgb(0 169 255 / 18%), transparent 30%),
      #101010;
  }

  .constraint-graphic svg {
    width: 100%;
    stroke: #76c7ff;
    stroke-width: 2;
    fill: none;
  }

  .constraint-node {
    display: flex;
    min-height: 130px;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 4%);
  }

  .constraint-node span,
  .browser-layer span,
  .example-heading span {
    color: #a1a1aa;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .constraint-node strong {
    color: white;
    font-size: 1.15rem;
  }

  .accent-node {
    border-color: rgb(118 199 255 / 48%);
  }

  .dom-detour {
    position: absolute;
    right: 2rem;
    bottom: 1rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.45rem;
    background: #242424;
    color: #71717a;
    font-size: 0.68rem;
    text-decoration: line-through;
  }

  .dom-detour strong {
    margin-left: 0.35rem;
  }

  .code-example-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .code-example-grid article,
  .browser-code-example {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 0.9rem;
    background: #101010;
  }

  .example-heading {
    margin-bottom: 1rem;
  }

  .example-heading h4 {
    margin-top: 0.25rem;
    color: white;
    font-size: 1rem;
  }

  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lifecycle-bridge {
    display: grid;
    grid-template-columns: minmax(160px, 0.7fr) minmax(240px, 1.3fr);
    gap: 0.4rem 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px dashed rgb(255 255 255 / 18%);
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 3%);
  }

  .lifecycle-bridge span {
    color: #76c7ff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lifecycle-bridge strong {
    color: white;
  }

  .lifecycle-bridge p {
    grid-column: 2;
    color: #a1a1aa;
    font-size: 0.8rem;
  }

  .timeline::before {
    position: absolute;
    top: 1.25rem;
    bottom: 1.25rem;
    left: 1.25rem;
    width: 1px;
    background: linear-gradient(#76c7ff, rgb(118 199 255 / 12%));
    content: "";
  }

  .timeline-phase {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1.5rem;
    margin: 0 0 1.5rem !important;
    padding: 0 !important;
    list-style: none !important;
  }

  .timeline-marker {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid rgb(118 199 255 / 60%);
    border-radius: 999px;
    background: #0b0b0b;
    color: #76c7ff;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .timeline-phase > article {
    padding: 1.5rem;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 0.9rem;
    background: linear-gradient(145deg, #121212, #0d0d0d);
  }

  .phase-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #a1a1aa;
    font-size: 0.75rem;
  }

  .phase-label {
    margin-top: 1.5rem !important;
  }

  .timeline-phase h4 {
    margin: 0.25rem 0 0.8rem;
    color: white;
    font-size: clamp(1.25rem, 3vw, 1.7rem);
  }

  .commit-subjects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .commit-subjects code {
    display: inline-block;
    padding: 0.35rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 0.35rem;
    color: #d4d4d8;
    font-size: 0.68rem;
    white-space: normal;
  }

  .interface-consequence {
    display: grid;
    grid-template-columns: minmax(150px, 0.8fr) minmax(220px, 1.2fr);
    gap: 0.4rem 1rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 10%);
  }

  .interface-consequence span {
    color: #71717a;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .interface-consequence strong {
    color: white;
  }

  .interface-consequence p {
    grid-column: 2;
    font-size: 0.85rem;
  }

  .product-figure {
    margin-top: 2.5rem;
  }

  .architecture-figure {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 1rem;
    background:
      linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px),
      #0f0f0f;
    background-size: 24px 24px;
  }

  .architecture-flow {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr) auto
      minmax(0, 1fr);
    align-items: stretch;
    gap: 0.55rem;
  }

  .architecture-flow article {
    min-width: 0;
