---
interface Interaction {
  number: string;
  title: string;
  keys?: string[];
  subject: string;
  detail: string;
}

interface Props {
  items: Interaction[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class:list={["interaction-grid", className]}>
  {
    items.map((idea) => (
      <article>
        <span class="idea-number">{idea.number}</span>
        <h4>{idea.title}</h4>
        {idea.keys && idea.keys.length > 0 && (
          <div class="key-sequence" aria-label={`${idea.title} controls`}>
            {idea.keys.map((key) => (
              <kbd>{key}</kbd>
            ))}
          </div>
        )}
        <p>
          <strong>{idea.subject}</strong> {idea.detail}
        </p>
      </article>
    ))
  }
</div>
