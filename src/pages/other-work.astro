---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
import WordpressFetcher from "../components/editorial/WordpressFetcher.tsx";
import OtherWorkGrid from "../components/editorial/OtherWorkGrid.astro";
import Footer from "../layouts/Footer.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import {
  formatDirectoryLabel,
  sectionIdFromEntry,
} from "../utils/other-work";

const entries = await getCollection("otherWork");

const bySection = new Map<string, CollectionEntry<"otherWork">[]>();
for (const entry of entries) {
  const section = sectionIdFromEntry(entry);
  const group = bySection.get(section) ?? [];
  group.push(entry);
  bySection.set(section, group);
}

for (const group of bySection.values()) {
  group.sort((a, b) => {
    const dateDiff = a.data.date.getTime() - b.data.date.getTime();
    if (dateDiff !== 0) return dateDiff;
    return a.data.order - b.data.order;
  });
}

const sectionOrder = [
  "layouts",
  "graphic-design",
  "design-club",
  "cooking",
  "personal",
];

const visibleSections = [
  ...sectionOrder.filter((id) => bySection.has(id)),
  ...[...bySection.keys()]
    .filter((id) => !sectionOrder.includes(id))
    .sort((a, b) => a.localeCompare(b)),
].map((id) => ({
  id,
  label: formatDirectoryLabel(id),
  maxCols: (id === "layouts" ? 2 : 3) as 2 | 3,
}));
---

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: auto;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: left;
    margin: 2rem;
  }
</style>

<Layout title="Other Work - Liam Sullivan">
  <main class="content">
    <BackLink label={"Back"} href="/" />
    <h1 class="my-20 text-5xl font-bold">Other Work</h1>
    {
      visibleSections.map((section, index) => {
        const headingId = `${section.id}-heading`;
        const isLastLocal = index === visibleSections.length - 1;

        return (
          <section
            class:list={[
              "mx-auto flex flex-col",
              isLastLocal ? "pb-28" : "mb-16",
            ]}
            aria-labelledby={headingId}
          >
            <p id={headingId} class="text-md mb-2 font-bold uppercase">
              {section.label}
            </p>
            <OtherWorkGrid
              entries={bySection.get(section.id) ?? []}
              maxCols={section.maxCols}
            />
          </section>
        );
      })
    }
    <section
      class="mx-auto flex flex-col pb-28"
      aria-labelledby="berlin-heading"
    >
      <p id="berlin-heading" class="text-md mb-2 font-bold uppercase">Berlin</p>
      <WordpressFetcher client:load />
    </section>
  </main>
  <Footer />
</Layout>
