---
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { PittIcon } from "../utils/icons";
import {
  formatDirectoryLabel,
  imageFromPublicPath,
  sectionIdFromEntry,
} from "../utils/other-work";

const featured = (await getCollection("otherWork"))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => {
    const dateDiff = a.data.date.getTime() - b.data.date.getTime();
    if (dateDiff !== 0) return dateDiff;
    return a.data.order - b.data.order;
  });
---

<div class="content">
  <div class="grid">
    {
      featured.map((entry) => {
        const img = imageFromPublicPath(entry.data.image);
        if (!img) return null;

        return (
          <Card
            title={entry.data.featuredTitle ?? entry.data.title}
            description={
              entry.data.featuredDescription ?? entry.data.description
            }
            img={img}
            banner1icon={PittIcon}
            banner1text={formatDirectoryLabel(sectionIdFromEntry(entry))}
            demoBtn={entry.data.link}
            externalLink={entry.data.externalLink}
          />
        );
      })
    }
  </div>
</div>
<ArrowLink href="/other-work/" label="Other Work" />
<style>
  .content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    list-style-type: none;
    width: 100%;
    gap: 2.5rem;
    margin-bottom: 1.5rem;
  }
  .grid {
    max-width: 1200px;
    margin: 0 auto;
    gap: 2rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (max-width: 850px) {
    .grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }
</style>
