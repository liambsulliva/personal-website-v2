---
const props = Astro.props
---

<div class="button">
    <svg xmlns="http://www.w3.org/2000/svg" width="2.5rem" height="2.5rem" viewBox="0 0 24 24" {...props}>
        <path fill="white" d="M11.01 3.05C6.51 3.54 3 7.36 3 12a9 9 0 0 0 9 9c4.63 0 8.45-3.5 8.95-8c.09-.79-.78-1.42-1.54-.95A5.403 5.403 0 0 1 11.1 7.5c0-1.06.31-2.06.84-2.89c.45-.67-.04-1.63-.93-1.56" />
    </svg>
</div>

<style>
	:root {
		--button-color: #fff;
		--new-button-color: #282935;
		--fill: #fff;
	}

	.button {
		position: absolute;
        top: 0.75em;
        left: 0.75em;
		display: flex;
		flex-direction: row;
        cursor: pointer;
		gap: 0.5rem;
		padding: 0.75rem 0.75rem;
		background-color: var(--new-button-color);
		border-radius: 25px;
		transition: all 0.2s;
		box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.25);
	}

	.button p {
		color: var(--fill);
		text-wrap: nowrap;
	}

	.button:hover {
		transform: scale(1.05);
	}

	.button:active {
		transform: scale(1);
	}

</style>