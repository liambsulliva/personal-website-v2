import CaptionedFigure from "../../components/CaptionedFigure.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import CaseStudySectionHeading from "../../components/case-study/CaseStudySectionHeading.astro";
import CaseStudyCopyGrid from "../../components/case-study/CaseStudyCopyGrid.astro";
import CaseStudyStatsGrid from "../../components/case-study/CaseStudyStatsGrid.astro";
import CaseStudyPipeline from "../../components/case-study/CaseStudyPipeline.astro";
import CaseStudyTimeline from "../../components/case-study/CaseStudyTimeline.astro";
import CaseStudyFeatureInventory from "../../components/case-study/CaseStudyFeatureInventory.astro";
import CaseStudyInteractionGrid from "../../components/case-study/CaseStudyInteractionGrid.astro";
import SwitchMenuPreview from "../../components/projects/SwitchMenuPreview.svelte";
import { switchReactMenuMockup } from "../../utils/images";

const sidebarItems = [
  { text: "Overview", href: "#overview" },
  { text: "Context", href: "#context" },
  { text: "Timeline", href: "#timeline" },
  { text: "Development", href: "#development" },
  { text: "Final Build", href: "#final-build" },
];

const overviewCopy = [
  {
    label: "Low-Level Control",
    body: "The framework gave me shockingly low-level access to the hardware. Through the Canvas API, I was able to draw pixels and shapes directly to the screen instead of interacting with a Document Object Model (DOM), like in traditional JavaScript.",
  },
  {
    label: "TypeScript Support",
    body: "Coming from a Java background, I'm a big fan of what TypeScript brings to JavaScript. Adding type safety to code is a common sense addition to any language, and it's become so ingrained in my workflow that I can't really live without it.",
  },
  {
    label: "React Tooling",
    body: "React's declarative UI feels like a natural fit for a quick and dirty app like this. Reacting to state changes felt far more natural to work with than manually updating the UI, especially when it came to handling controller input.",
  },
];

const overviewStats = [
  { value: "92", label: "total commits" },
  { value: "4", label: "total bursts of freeform work" },
  { value: "1", label: "UI shared between the Nintendo Switch and browser" },
];

const pipelineNodes = [
  {
    step: "01 - Source",
    title: "React Components",
    body: `Components like <code>Rect</code>, <code>Text</code>, and <code>Image</code> from <a href="https://github.com/TooTallNate/react-tela" target="_blank" rel="noopener noreferrer">react-tela</a> act as the building blocks of the UI.`,
  },
  {
    step: "02 - Reconciler",
    title: "react-tela",
    body: "The Custom React renderer walks through the elements and queues them to be painted to the screen with the Canvas2D API.",
  },
  {
    step: "03 - Screen",
    title: "Canvas2D",
    body: "The <code>render</code> function paints straight onto the Switch's screen.",
  },
];

