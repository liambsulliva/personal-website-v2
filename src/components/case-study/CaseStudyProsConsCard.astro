---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  pros: string[];
  cons: string[];
  class?: string;
}

const { title, image, imageAlt, pros, cons, class: className } = Astro.props;
---

<article class:list={["prototype-option-card", className]}>
  <div class="prototype-option-layout">
    <div class="prototype-option-media">
      <Image
        src={image}
        alt={imageAlt}
        class="prototype-option-image"
        loading="lazy"
      />
    </div>
    <div class="prototype-option-copy">
      <h4>{title}</h4>
      <div class="prototype-option-rows">
        {
          pros.map((pro) => (
            <div class="prototype-option-row prototype-option-row--pro">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="1.375rem"
                height="1.375rem"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  fill="#0E9F6E"
                  d="M23 10a2 2 0 0 0-2-2h-6.32l.96-4.57c.02-.1.03-.21.03-.32c0-.41-.17-.79-.44-1.06L14.17 1L7.59 7.58C7.22 7.95 7 8.45 7 9v10a2 2 0 0 0 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73zM1 21h4V9H1z"
                />
              </svg>
              <p>{pro}</p>
            </div>
          ))
        }
        {
          cons.map((con) => (
            <div class="prototype-option-row prototype-option-row--con">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="1.375rem"
                height="1.375rem"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  fill="#F05252"
                  d="M19 15h4V3h-4m-4 0H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2a2 2 0 0 0 2 2h6.31l-.95 4.57c-.02.1-.03.2-.03.31c0 .42.17.79.44 1.06L9.83 23l6.58-6.59c.37-.36.59-.86.59-1.41V5a2 2 0 0 0-2-2"
                />
              </svg>
              <p>{con}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</article>
