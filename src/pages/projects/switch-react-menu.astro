    }

    .dom-detour strong {
      margin-left: 0.35rem;
    }

    .constraint-caption {
      color: #71717a;
      font-size: 0.72rem;
      line-height: 1.5;
      text-align: left;
    }

    .constraint-caption code {
      padding: 0.05rem 0.25rem;
      font-size: 0.68rem;
    }

    .code-example-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
